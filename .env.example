# Get this token from @BotFather. Never commit your real token.
BOT_TOKEN=replace_with_botfather_token

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace_with_long_random_secret

# Set this after Koyeb assigns your public domain. No trailing slash.
WEBHOOK_URL=https://your-app-your-org.koyeb.app

MAX_UPLOAD_MB=18
LOG_LEVEL=INFO
